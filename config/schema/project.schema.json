{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apple ecosystem project scaffold configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "identity", "platforms", "modules"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "slug": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"}
      }
    },
    "identity": {"enum": ["playful-kinetic", "calm-precise", "dark-technical"]},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ios", "ipados", "macos", "watchos", "tvos", "visionos"]}
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["accounts", "active-activity", "app-intents", "background-work", "commerce", "notifications", "share", "sync", "widgets"]}
    }
  }
}
